<?xml version="1.0" encoding="utf-8"?>
<!--
    res/values/strings.xml: TEXTOS de la app.
    Buena práctica: no escribir textos "en duro" en el código.
    En Compose se leen con stringResource(R.string.nombre).
    Ventaja: traducir la app = crear values-en/strings.xml con los mismos nombres.
-->
