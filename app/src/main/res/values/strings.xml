    <string name="saludo">Hola, %1$s</string>

    <!-- Descripciones para accesibilidad (TalkBack) -->
    <string name="cd_mostrar_contrasena">Mostrar contraseña</string>
    <string name="cd_ocultar_contrasena">Ocultar contraseña</string>
